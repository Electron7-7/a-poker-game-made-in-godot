; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Schedule_1_Multiplayer"
run/main_scene="uid://do2p13ax6dwwt"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

global_MenuManager="*res://managers/menu_manager.gd"
global_GameManager="*res://managers/game_manager.gd"
global_NetworkManager="*res://managers/network_manager.gd"
global_SettingsManager="*res://managers/settings_manager.gd"
global_WorldManager="*res://managers/world_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

Persist="Nodes that will be saved (as long as they have a 'save' function)"
PlayerSpawn="A player spawn point"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=70
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

environment/defaults/default_environment="uid://2r02414ncg7t"
